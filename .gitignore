###############################################################################
# CORE RULE: Ignore everything except the app and Documents folders
###############################################################################

/*
!/app/
!/Documents/
!/.gitignore
!/README.md
!/index.html
!/roster-v2-sample.json

# Keep essential build files (Recommended for project builds)
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle/

# Specific ignores for Android/IDE
.idea/
.gradle/
build/
*.iml
local.properties
.DS_Store
captures/
*.hprof
.navigation/
*.keystore
*.jks

# Android C++ / NDK build artifacts
.cxx/
.externalNativeBuild/

# Presentation script
Presentation_Script.md

*.apk
*.aab


###############################################################################
# IOS / XCODE LOCAL USER FILES
###############################################################################

ios/.xcode.env.local
xcuserdata/
*.xcuserstate
*.pbxuser
*.mode1v3
*.xcscmblueprint
*.xcworkspace


###############################################################################
# FIREBASE CONFIG / SECRETS
###############################################################################

google-services.json
serviceAccountKey.json
firebase-adminsdk*.json
firebase-debug.log
firestore-debug.log


###############################################################################
# OS / COMPILED ARTIFACTS
###############################################################################

*.dSYM
*.exe
*.dll


###############################################################################
# ARCHIVES / COMPRESSED FILES
###############################################################################

*.zip
*.tar
*.tar.gz
*.rar
*.7z


###############################################################################
# GITHUB / CI OUTPUT
###############################################################################

.github/workflows/*.log


###############################################################################
# EXCEPTIONS (UN-IGNORE RULES)
#
# VERY IMPORTANT:
# - These rules OVERRIDE earlier ignore rules
# - They MUST be at the BOTTOM of the file
#
# Syntax:
#   !filename
#
# Means:
#   "Even if this was ignored above, KEEP IT"
#
###############################################################################

# Gradle wrapper (REQUIRED for Android builds)
!gradlew
!gradlew.bat
!gradle/
!gradle/wrapper/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Project documentation
!README.md
!docs/**

# GitHub Actions workflows (definitions only)
!.github/workflows/*.yml

# React Native / Xcode env file (REQUIRED for iOS builds)
!.xcode.env
!ios/.xcode.env
